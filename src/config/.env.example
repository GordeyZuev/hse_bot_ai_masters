# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMINS=[your_admin_user_id_here]
# Полный URL, например socks5://user:password@host:port. Пусто — без прокси.
BOT_PROXY=

# External Services Configuration
FCS_WIKI_URL=http://wiki.cs.hse.ru/your_course_wiki_page
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/your_spreadsheet_id/edit
GOOGLE_CREDS_FILE=src/config/creds.json

# Application Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
CONSOLE_LOGS=true
LOG_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=365
ENVIRONMENT=production
TZ=Europe/Moscow
RICH_MESSAGES_ENABLED=false

# PostgreSQL (используется и приложением, и docker-compose)
POSTGRES_DB=hse_bot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
# Для локального запуска задайте DB_HOST=localhost
DB_HOST=db
DB_PORT=5432
