# Telegram Bot Configuration
BOT_TOKEN=your_telegram_bot_token_here
ADMINS=[your_admin_user_ids_here]

# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_password@db:5432/hse_bot_db
DB_HOST=db
DB_PORT=5432
DB_NAME=hse_bot_db
DB_USER=postgres
DB_PASSWORD=your_secure_password

# Google Sheets Configuration
FCS_WIKI_URL=http://wiki.cs.hse.ru/Машинное_обучение_и_высоконагруженные_системы
GOOGLE_SHEETS_URL=https://docs.google.com/spreadsheets/d/your_sheet_id/edit
GOOGLE_CREDS_FILE=src/config/creds.json

# Application Configuration
LOG_LEVEL=INFO
LOG_DIR=logs
ENVIRONMENT=production
TZ=Europe/Moscow

# PostgreSQL Configuration (для docker-compose)
POSTGRES_DB=hse_bot_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
